# SOLO SERVIDOR. Completar la clave de Groq, sin NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# npm run setup:ai genera estos dos secretos en .env.local si faltan.
# AI_ACCESS_CODE se comparte con quienes pueden usar la IA de la fiesta.
# AI_SESSION_SECRET permanece privado en el servidor (mínimo 32 caracteres).
AI_ACCESS_CODE=
AI_SESSION_SECRET=

# En internet, reemplazar por el origen HTTPS exacto. Varios orígenes: separados por comas.
AI_ALLOWED_ORIGINS=http://localhost:3000

# Límites de peticiones, compartidos entre usuarios/instancias en producción.
# Las pruebas de conexión también consumen cupo. No representan un límite monetario.
AI_DAILY_REQUEST_LIMIT=100
AI_SESSION_HOURLY_LIMIT=6

# Obligatorio para IA en producción. Redis REST de Upstash, solo en el servidor.
# En desarrollo, sin estas variables se usan contadores en memoria.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
